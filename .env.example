# ──────────────────────────────────────────────────────────────
# Soltria · Portal de Aprovação — variáveis de ambiente
# Copie para .env.local (local) e cadastre as mesmas na Vercel.
# Supabase → Project Settings → API
# ──────────────────────────────────────────────────────────────

# URL do projeto Supabase (pública)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave "anon / publishable" (pública — protegida por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave "service_role" — SECRETA. Só é usada no servidor (portal do cliente,
# URLs assinadas, seed). NUNCA use o prefixo NEXT_PUBLIC_ nela.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (usada para montar o link de aprovação).
# Local: http://localhost:3000 · Produção: https://seu-dominio.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# (Opcional) Integração futura de e-mail (ex.: Resend). Veja lib/notifications.ts
# RESEND_API_KEY=
# NOTIFICATIONS_FROM="Soltria <aprovacao@seu-dominio.com.br>"
# ADMIN_NOTIFICATION_EMAIL=voce@seu-dominio.com.br
